generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Specialist {
  id                 String    @id
  name               String
  title              String
  bio                String?
  photoUrl           String?
  spriteFrames       Int?
  spriteWidth        Int?
  skills             String    @default("[]")
  stats              String    @default("[]")
  googleEmail        String?
  googlePicture      String?
  googleRefreshToken String?
  rotationUrl        String?
  rotationFrames     Int?
  rotationWidth      Int?
  phone              String?
  isActive           Boolean   @default(true)
  sortOrder          Int       @default(0)
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
  bookings           Booking[]
}

model MessageQueue {
  id          String    @id @default(cuid())
  recipient   String
  text        String
  status      String    @default("PENDING") // PENDING | SENT | FAILED
  scheduledAt DateTime
  sentAt      DateTime?
  attempts    Int       @default(0)
  lastError   String?
  createdAt   DateTime  @default(now())

  @@index([status, scheduledAt])
}

model Booking {
  id            String     @id @default(cuid())
  specialistId  String
  specialist    Specialist @relation(fields: [specialistId], references: [id])
  wasAnyRequest Boolean    @default(false)
  clientName    String
  clientEmail   String
  clientPhone   String
  subject       String
  startsAt      DateTime
  endsAt        DateTime
  googleEventId String?
  meetLink      String?
  status        String     @default("CONFIRMED")
  createdAt     DateTime   @default(now())

  @@index([specialistId, startsAt])
  @@index([wasAnyRequest, createdAt])
}
